
import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.util.ArrayList;

public class SecurePasswordManager extends JFrame {

    // Security PIN (demo purpose)
    private static final String SECURITY_PIN = "1234";

    // Store passwords while the application is running
    private ArrayList<String[]> passwordList = new ArrayList<>();

    private int attempts = 3;

    // UI colors
    private final Color BACKGROUND = new Color(24, 28, 39);
    private final Color PANEL = new Color(36, 42, 56);
    private final Color ACCENT = new Color(99, 102, 241);
    private final Color WHITE = Color.WHITE;

    public SecurePasswordManager() {
        setTitle("Secure Password Manager");
        setSize(650, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        showLoginScreen();
    }

    // LOGIN SCREEN
    private void showLoginScreen() {

        getContentPane().removeAll();
        setLayout(new BorderLayout());

        JPanel panel = new JPanel();
        panel.setBackground(BACKGROUND);
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBorder(new EmptyBorder(65, 120, 50, 120));

        JLabel title = new JLabel("SECURE VAULT");
        title.setFont(new Font("Arial", Font.BOLD, 30));
        title.setForeground(WHITE);
        title.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel subtitle = new JLabel("Your personal password manager");
        subtitle.setForeground(Color.LIGHT_GRAY);
        subtitle.setAlignmentX(Component.CENTER_ALIGNMENT);

        JPasswordField pinField = new JPasswordField();
        pinField.setMaximumSize(new Dimension(300, 40));
        pinField.setFont(new Font("Arial", Font.PLAIN, 18));
        pinField.setHorizontalAlignment(JTextField.CENTER);

        JButton loginButton = createButton("Unlock Vault");

        JLabel message = new JLabel("Enter your 4-digit security PIN");
        message.setForeground(Color.LIGHT_GRAY);
        message.setAlignmentX(Component.CENTER_ALIGNMENT);

        loginButton.addActionListener(e -> {

            String enteredPin = new String(pinField.getPassword());

            if (enteredPin.equals(SECURITY_PIN)) {
                attempts = 3;
                showDashboard();
            } else {
                attempts--;

                if (attempts == 0) {
                    JOptionPane.showMessageDialog(
                        this,
                        "Too many incorrect attempts. Application closing."
                    );
                    System.exit(0);
                } else {
                    message.setText(
                        "Incorrect PIN! Attempts left: " + attempts
                    );
                    message.setForeground(Color.PINK);
                    pinField.setText("");
                }
            }
        });

        panel.add(title);
        panel.add(Box.createVerticalStrut(12));
        panel.add(subtitle);
        panel.add(Box.createVerticalStrut(45));
        panel.add(message);
        panel.add(Box.createVerticalStrut(12));
        panel.add(pinField);
        panel.add(Box.createVerticalStrut(25));
        panel.add(loginButton);

        add(panel, BorderLayout.CENTER);

        revalidate();
        repaint();
    }

    // MAIN DASHBOARD
    private void showDashboard() {

        getContentPane().removeAll();
        setLayout(new BorderLayout());

        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(PANEL);
        header.setBorder(new EmptyBorder(20, 25, 20, 25));

        JLabel heading = new JLabel("My Password Vault");
        heading.setForeground(WHITE);
        heading.setFont(new Font("Arial", Font.BOLD, 24));

        JButton logoutButton = createButton("Logout");
        logoutButton.addActionListener(e -> showLoginScreen());

        header.add(heading, BorderLayout.WEST);
        header.add(logoutButton, BorderLayout.EAST);

        JPanel content = new JPanel();
        content.setBackground(BACKGROUND);
        content.setLayout(new BoxLayout(content, BoxLayout.Y_AXIS));
        content.setBorder(new EmptyBorder(40, 100, 40, 100));

        JButton addButton = createButton(" + Add New Password");
        JButton viewButton = createButton("View Saved Passwords");
        JButton deleteButton = createButton("Delete Password");

        addButton.addActionListener(e -> addPassword());
        viewButton.addActionListener(e -> viewPasswords());
        deleteButton.addActionListener(e -> deletePassword());

        content.add(addButton);
        content.add(Box.createVerticalStrut(20));
        content.add(viewButton);
        content.add(Box.createVerticalStrut(20));
        content.add(deleteButton);

        JLabel count = new JLabel(
            "Saved Accounts: " + passwordList.size()
        );
        count.setForeground(Color.LIGHT_GRAY);
        count.setAlignmentX(Component.CENTER_ALIGNMENT);

        content.add(Box.createVerticalStrut(35));
        content.add(count);

        add(header, BorderLayout.NORTH);
        add(content, BorderLayout.CENTER);

        revalidate();
        repaint();
    }

    // ADD PASSWORD
    private void addPassword() {

        JTextField websiteField = new JTextField();
        JPasswordField passwordField = new JPasswordField();

        Object[] fields = {
            "Website / Application:", websiteField,
            "Password:", passwordField
        };

        int result = JOptionPane.showConfirmDialog(
            this,
            fields,
            "Add New Password",
            JOptionPane.OK_CANCEL_OPTION
        );

        if (result == JOptionPane.OK_OPTION) {

            String website = websiteField.getText().trim();
            String password = new String(passwordField.getPassword());

            if (website.isEmpty() || password.isEmpty()) {
                JOptionPane.showMessageDialog(
                    this,
                    "Please fill in all fields."
                );
                return;
            }

            passwordList.add(new String[]{website, password});

            JOptionPane.showMessageDialog(
                this,
                "Password saved successfully!"
            );

            showDashboard();
        }
    }

    // VIEW PASSWORDS
    private void viewPasswords() {

        if (passwordList.isEmpty()) {
            JOptionPane.showMessageDialog(
                this,
                "No passwords saved yet."
            );
            return;
        }

        String[] options = new String[passwordList.size()];

        for (int i = 0; i < passwordList.size(); i++) {
            options[i] = passwordList.get(i)[0];
        }

        String selected = (String) JOptionPane.showInputDialog(
            this,
            "Select an account:",
            "Saved Passwords",
            JOptionPane.PLAIN_MESSAGE,
            null,
            options,
            options[0]
        );

        if (selected == null) {
            return;
        }

        for (String[] account : passwordList) {

            if (account[0].equals(selected)) {

                JPasswordField passwordField =
                    new JPasswordField(account[1], 25);

                JCheckBox showPassword =
                    new JCheckBox("Show Password");

                showPassword.addActionListener(e -> {
                    if (showPassword.isSelected()) {
                        passwordField.setEchoChar((char) 0);
                    } else {
                        passwordField.setEchoChar('\u2022');
                    }
                });

                JPanel panel = new JPanel(new BorderLayout(5, 10));
                panel.add(passwordField, BorderLayout.CENTER);
                panel.add(showPassword, BorderLayout.SOUTH);

                JOptionPane.showMessageDialog(
                    this,
                    panel,
                    selected + " Password",
                    JOptionPane.PLAIN_MESSAGE
                );

                break;
            }
        }
    }

    // DELETE PASSWORD
    private void deletePassword() {

        if (passwordList.isEmpty()) {
            JOptionPane.showMessageDialog(
                this,
                "No passwords available to delete."
            );
            return;
        }

        String[] options = new String[passwordList.size()];

        for (int i = 0; i < passwordList.size(); i++) {
            options[i] = passwordList.get(i)[0];
        }

        String selected = (String) JOptionPane.showInputDialog(
            this,
            "Select an account to delete:",
            "Delete Password",
            JOptionPane.WARNING_MESSAGE,
            null,
            options,
            options[0]
        );

        if (selected != null) {

            int confirm = JOptionPane.showConfirmDialog(
                this,
                "Are you sure you want to delete " + selected + "?",
                "Confirm Delete",
                JOptionPane.YES_NO_OPTION
            );

            if (confirm == JOptionPane.YES_OPTION) {

                passwordList.removeIf(
                    account -> account[0].equals(selected)
                );

                JOptionPane.showMessageDialog(
                    this,
                    "Password deleted successfully!"
                );

                showDashboard();
            }
        }
    }

    // REUSABLE BUTTON DESIGN
    private JButton createButton(String text) {

        JButton button = new JButton(text);

        button.setFont(new Font("Arial", Font.BOLD, 15));
        button.setForeground(WHITE);
        button.setBackground(ACCENT);
        button.setFocusPainted(false);
        button.setBorder(new EmptyBorder(12, 20, 12, 20));
        button.setAlignmentX(Component.CENTER_ALIGNMENT);
        button.setMaximumSize(new Dimension(300, 50));
        button.setCursor(new Cursor(Cursor.HAND_CURSOR));

        return button;
    }

    // MAIN METHOD
    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            SecurePasswordManager app =
                new SecurePasswordManager();

            app.setVisible(true);
        });
    }
}
