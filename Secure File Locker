
import javax.swing.*;
import java.awt.*;
import java.io.*;

public class SecureFileLocker extends JFrame {

    private static final String PIN = "2468";
    private static final String FILE_NAME = "secret.txt";

    private final Color BACKGROUND = new Color(25, 29, 42);
    private final Color PANEL = new Color(38, 44, 60);
    private final Color ACCENT = new Color(99, 102, 241);

    private JTextArea textArea;
    private JLabel statusLabel;

    private boolean unlocked = false;
    private int attempts = 3;

    public SecureFileLocker() {

        setTitle("Secure File Locker");
        setSize(650, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        showLoginScreen();
    }

    // LOGIN SCREEN
    private void showLoginScreen() {

        getContentPane().removeAll();
        setLayout(new BorderLayout());

        JPanel panel = new JPanel();
        panel.setBackground(BACKGROUND);
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBorder(BorderFactory.createEmptyBorder(
            80, 120, 50, 120
        ));

        JLabel title = new JLabel("SECURE FILE LOCKER");
        title.setFont(new Font("Arial", Font.BOLD, 27));
        title.setForeground(Color.WHITE);
        title.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel subtitle = new JLabel("Protect your private notes");
        subtitle.setForeground(Color.LIGHT_GRAY);
        subtitle.setAlignmentX(Component.CENTER_ALIGNMENT);

        JPasswordField pinField = new JPasswordField();
        pinField.setMaximumSize(new Dimension(300, 40));
        pinField.setHorizontalAlignment(JTextField.CENTER);

        JButton loginButton = createButton("Unlock");

        JLabel message = new JLabel("Enter your security PIN");
        message.setForeground(Color.LIGHT_GRAY);
        message.setAlignmentX(Component.CENTER_ALIGNMENT);

        loginButton.addActionListener(e -> {

            String enteredPin =
                new String(pinField.getPassword());

            if (enteredPin.equals(PIN)) {

                unlocked = true;
                attempts = 3;
                showDashboard();

            } else {

                attempts--;

                if (attempts == 0) {
                    JOptionPane.showMessageDialog(
                        this,
                        "Maximum attempts reached. Closing application."
                    );
                    System.exit(0);
                }

                message.setText(
                    "Incorrect PIN! Attempts left: " + attempts
                );

                message.setForeground(Color.PINK);
                pinField.setText("");
            }
        });

        panel.add(title);
        panel.add(Box.createVerticalStrut(15));
        panel.add(subtitle);
        panel.add(Box.createVerticalStrut(40));
        panel.add(message);
        panel.add(Box.createVerticalStrut(12));
        panel.add(pinField);
        panel.add(Box.createVerticalStrut(20));
        panel.add(loginButton);

        add(panel, BorderLayout.CENTER);

        revalidate();
        repaint();
    }

    // MAIN DASHBOARD
    private void showDashboard() {

        getContentPane().removeAll();
        setLayout(new BorderLayout());

        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(PANEL);
        header.setBorder(BorderFactory.createEmptyBorder(
            20, 25, 20, 25
        ));

        JLabel title = new JLabel("My Private Locker");
        title.setForeground(Color.WHITE);
        title.setFont(new Font("Arial", Font.BOLD, 23));

        JButton logoutButton = createButton("Lock & Logout");

        logoutButton.addActionListener(e -> {
            unlocked = false;
            textArea.setText("");
            showLoginScreen();
        });

        header.add(title, BorderLayout.WEST);
        header.add(logoutButton, BorderLayout.EAST);

        textArea = new JTextArea();
        textArea.setFont(new Font("Arial", Font.PLAIN, 16));
        textArea.setLineWrap(true);
        textArea.setWrapStyleWord(true);
        textArea.setBackground(PANEL);
        textArea.setForeground(Color.WHITE);
        textArea.setCaretColor(Color.WHITE);
        textArea.setBorder(BorderFactory.createEmptyBorder(
            15, 15, 15, 15
        ));

        JScrollPane scrollPane = new JScrollPane(textArea);
        scrollPane.setBorder(BorderFactory.createEmptyBorder(
            20, 25, 10, 25
        ));

        JPanel bottom = new JPanel();
        bottom.setBackground(BACKGROUND);

        JButton saveButton = createButton("Save File");
        JButton openButton = createButton("Open File");
        JButton clearButton = createButton("Clear Text");

        statusLabel = new JLabel("Locker unlocked");
        statusLabel.setForeground(Color.GREEN);

        saveButton.addActionListener(e -> saveFile());
        openButton.addActionListener(e -> openFile());

        clearButton.addActionListener(e -> {
            textArea.setText("");
            statusLabel.setText("Editor cleared");
        });

        bottom.add(saveButton);
        bottom.add(openButton);
        bottom.add(clearButton);

        JPanel footer = new JPanel(new BorderLayout());
        footer.setBackground(BACKGROUND);
        footer.setBorder(BorderFactory.createEmptyBorder(
            5, 25, 15, 25
        ));

        footer.add(bottom, BorderLayout.CENTER);
        footer.add(statusLabel, BorderLayout.SOUTH);

        add(header, BorderLayout.NORTH);
        add(scrollPane, BorderLayout.CENTER);
        add(footer, BorderLayout.SOUTH);

        revalidate();
        repaint();
    }

    // SAVE CONTENT TO FILE
    private void saveFile() {

        if (!unlocked) {
            return;
        }

        try (FileWriter writer = new FileWriter(FILE_NAME)) {

            writer.write(textArea.getText());

            statusLabel.setText("File saved successfully!");

        } catch (IOException e) {

            JOptionPane.showMessageDialog(
                this,
                "Error saving file: " + e.getMessage()
            );
        }
    }

    // READ CONTENT FROM FILE
    private void openFile() {

        if (!unlocked) {
            return;
        }

        File file = new File(FILE_NAME);

        if (!file.exists()) {

            JOptionPane.showMessageDialog(
                this,
                "No saved file found. Save something first."
            );

            return;
        }

        try (BufferedReader reader =
                 new BufferedReader(new FileReader(FILE_NAME))) {

            textArea.setText("");

            String line;

            while ((line = reader.readLine()) != null) {
                textArea.append(line + "\n");
            }

            statusLabel.setText("File opened successfully!");

        } catch (IOException e) {

            JOptionPane.showMessageDialog(
                this,
                "Error opening file: " + e.getMessage()
            );
        }
    }

    // REUSABLE BUTTON DESIGN
    private JButton createButton(String text) {

        JButton button = new JButton(text);

        button.setFont(new Font("Arial", Font.BOLD, 13));
        button.setForeground(Color.WHITE);
        button.setBackground(ACCENT);
        button.setFocusPainted(false);
        button.setBorder(BorderFactory.createEmptyBorder(
            12, 18, 12, 18
        ));

        return button;
    }

    // MAIN METHOD
    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            SecureFileLocker app = new SecureFileLocker();
            app.setVisible(true);

        });
    }
}
